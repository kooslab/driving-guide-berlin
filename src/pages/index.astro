---
import GuideLayout from '../layouts/GuideLayout.astro';

const driving = [
  { href: '/auto',  emoji: '🚗', title: 'Auto Guide',  subtitle: 'Car driving rules', desc: '73 animated scenes across 10 chapters — right-of-way, signs, trams, parking and more.' },
  { href: '/bike',  emoji: '🚲', title: 'Bike Guide',  subtitle: 'Cycling rules',      desc: '30 scenes across 6 chapters — cycle paths, turning, tram tracks, traffic lights.' },
];

const daily = [
  { href: '/daily/food',      emoji: '🍽️', title: 'Food & Drink',  desc: 'Döner stand, restaurant, bakery, supermarket, café — order and pay with confidence.' },
  { href: '/daily/transport', emoji: '🚇', title: 'Transport',      desc: 'U-Bahn, S-Bahn, tram, bus, Uber and taxi — buy tickets, ask for stops, sort problems.' },
  { href: '/daily/errands',   emoji: '🏪', title: 'Errands',        desc: 'Post office, pharmacy, bank, gas station — get everyday tasks done in German.' },
  { href: '/daily/health',    emoji: '🏥', title: 'Health',         desc: 'Book a doctor, describe symptoms, get a prescription or Krankmeldung.' },
  { href: '/daily/admin',     emoji: '📋', title: 'Admin',          desc: 'Anmeldung, Bürgeramt, Ausländerbehörde, filling in forms — the bureaucracy survival kit.' },
  { href: '/daily/housing',   emoji: '🏠', title: 'Housing',        desc: 'Call your landlord, arrange a repair, view an apartment, give notice.' },
  { href: '/daily/airport',   emoji: '✈️', title: 'Airport',        desc: 'Check-in, security, boarding, lost luggage and getting from BER into the city.' },
];
---
<GuideLayout title="Berlin Guides — Driving & Daily Life" description="Animated driving rules and DE/EN conversation guides for expats living in Berlin." currentPage="/">
<style is:global>
.home-wrap{max-width:1080px;margin:0 auto;padding:56px 24px 80px}

/* hero */
.home-hero{margin-bottom:64px}
.home-hero h1{font:700 clamp(40px,6vw,72px)/1 var(--display);margin:0 0 16px;text-wrap:balance}
.home-hero h1 span{color:var(--accent)}
.home-hero p{font-size:18px;color:var(--muted);max-width:56ch;line-height:1.6;margin:0 0 10px}
.home-hero .tagline{display:inline-flex;align-items:center;gap:8px;font:600 13px var(--body);letter-spacing:.08em;text-transform:uppercase;color:var(--faint);margin-bottom:20px}
.home-hero .tagline::before,.home-hero .tagline::after{content:'';flex:1;height:1px;background:var(--line);width:40px}

/* section headers */
.home-section{margin-bottom:56px}
.home-section-label{font:600 11px var(--body);letter-spacing:.12em;text-transform:uppercase;color:var(--faint);margin:0 0 6px}
.home-section-title{font:700 clamp(24px,3vw,32px)/1.1 var(--display);margin:0 0 20px}

/* driving cards */
.driving-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}
.driving-card{display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:24px;text-decoration:none;color:inherit;transition:border-color .15s,box-shadow .15s}
.driving-card:hover{border-color:var(--accent);box-shadow:var(--shadow)}
.driving-card-icon{font-size:36px;margin-bottom:12px;display:block}
.driving-card-title{font:700 22px/1 var(--display);margin:0 0 2px}
.driving-card-subtitle{font:400 12px var(--body);color:var(--muted);margin:0 0 12px;text-transform:uppercase;letter-spacing:.06em}
.driving-card-desc{font-size:14px;color:var(--muted);line-height:1.5;margin:0 0 16px;flex:1}
.driving-card-cta{font:600 13px var(--body);color:var(--accent);display:flex;align-items:center;gap:4px}
.driving-card-cta::after{content:'→'}

/* daily life grid */
.daily-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px}
.daily-card{display:flex;gap:14px;align-items:flex-start;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px;text-decoration:none;color:inherit;transition:border-color .15s}
.daily-card:hover{border-color:var(--accent)}
.daily-card-icon{font-size:28px;flex:none;line-height:1}
.daily-card-title{font:700 16px/1.1 var(--display);margin:0 0 4px}
.daily-card-desc{font-size:13px;color:var(--muted);line-height:1.4;margin:0}

/* how it works */
.how-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;margin-top:20px}
.how-card{background:var(--surface-2);border-radius:12px;padding:20px}
.how-card .num{font:700 28px/1 var(--display);color:var(--accent-soft);margin-bottom:8px}
.how-card h3{font:700 16px/1.1 var(--display);margin:0 0 6px}
.how-card p{font-size:13px;color:var(--muted);line-height:1.5;margin:0}

/* footer strip */
.home-footer{margin-top:64px;padding-top:24px;border-top:1px solid var(--line);font-size:13px;color:var(--faint)}

@media(max-width:600px){
  .home-wrap{padding:32px 16px 56px}
  .driving-grid{grid-template-columns:1fr}
}
</style>

<div class="home-wrap">

  <!-- hero -->
  <header class="home-hero">
    <div class="tagline">For expats living in Berlin</div>
    <h1>Speak German.<br><span>Get around Berlin.</span></h1>
    <p>Animated driving rules and real-life conversation guides — everything you need to navigate Berlin with confidence, from the Bürgeramt to the Döner stand.</p>
    <p>Every phrase in <strong>German</strong> with English translation, plus natural-sounding variations for every situation.</p>
  </header>

  <!-- driving -->
  <section class="home-section">
    <p class="home-section-label">On the road</p>
    <h2 class="home-section-title">Driving & Cycling Rules</h2>
    <div class="driving-grid">
      {driving.map(g => (
        <a class="driving-card" href={g.href}>
          <span class="driving-card-icon">{g.emoji}</span>
          <div class="driving-card-title">{g.title}</div>
          <div class="driving-card-subtitle">{g.subtitle}</div>
          <p class="driving-card-desc">{g.desc}</p>
          <span class="driving-card-cta">Open guide</span>
        </a>
      ))}
    </div>
  </section>

  <!-- daily life -->
  <section class="home-section">
    <p class="home-section-label">Around town</p>
    <h2 class="home-section-title">Daily Life Conversation Guides</h2>
    <div class="daily-grid">
      {daily.map(g => (
        <a class="daily-card" href={g.href}>
          <span class="daily-card-icon">{g.emoji}</span>
          <div>
            <div class="daily-card-title">{g.title}</div>
            <p class="daily-card-desc">{g.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- how it works -->
  <section class="home-section">
    <p class="home-section-label">How it works</p>
    <h2 class="home-section-title">Built for real situations</h2>
    <div class="how-grid">
      <div class="how-card">
        <div class="num">DE</div>
        <h3>German first</h3>
        <p>Every phrase leads with German — the language you'll actually need. English sits quietly below.</p>
      </div>
      <div class="how-card">
        <div class="num">±</div>
        <h3>Phrase variations</h3>
        <p>Tap any bubble to see alternate ways to say the same thing — formal, informal, shorter, longer.</p>
      </div>
      <div class="how-card">
        <div class="num">🎬</div>
        <h3>Animated scenes</h3>
        <p>Driving rules play out as animated diagrams so you see exactly what happens at each crossing or sign.</p>
      </div>
      <div class="how-card">
        <div class="num">📍</div>
        <h3>Berlin-specific</h3>
        <p>BVG tickets, Anmeldung, Pfand, Payback — the real Berlin experience, not generic textbook German.</p>
      </div>
    </div>
  </section>

  <footer class="home-footer">
    Made for expats in Berlin · All content is for guidance only · Traffic rules: StVO
  </footer>

</div>
</GuideLayout>
